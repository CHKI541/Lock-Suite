<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LockSuiteAdmin"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <!--
            allowBackup="false" es deliberado y NO se debe volver a poner en true.
            La sesión de administrador (cookies + almacenamiento del WebView) vive en
            el directorio de datos de esta app. Con allowBackup="true" esa sesión se
            copia al backup de Google y se puede extraer con `adb backup` en equipos
            viejos: alcanzaría con eso para entrar al panel de MDM sin la contraseña.

            launchMode="singleTask": evita que queden dos instancias del panel abiertas
            (por ejemplo si el usuario vuelve desde el selector de archivos).

            configChanges: la lista larga es a propósito. Cada configuración que NO esté
            acá hace que Android destruya y recree la Activity, y recrear significa
            volver a cargar el panel entero. Con la lista completa, cambiar el modo
            oscuro, el tamaño de fuente, el idioma o rotar el equipo no interrumpe lo
            que estabas haciendo.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|density|fontScale|uiMode|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>

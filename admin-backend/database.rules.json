{
  "rules": {
    "devices": {
      ".read": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())",
      "$device_id": {
        ".read": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())",
        ".write": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists() || !data.exists() || data.child('ownerUid').val() === auth.uid || newData.child('ownerUid').val() === auth.uid)"
      }
    },
    "deviceSecrets": {
      ".read": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())",
      "$device_id": {
        ".write": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists() || !data.exists() || data.child('ownerUid').val() === auth.uid || newData.child('ownerUid').val() === auth.uid || root.child('devices').child($device_id).child('ownerUid').val() === auth.uid)",
        "commandSecret": {
          ".write": "auth != null && (!data.exists() || newData.val() === data.val() || auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())"
        }
      }
    },
    "authorizedAdmins": {
      ".read": "auth != null && root.child('authorizedAdminsUids').child(auth.uid).exists()",
      ".write": "false"
    },
    "authorizedAdminsUids": {
      ".read": "auth != null && root.child('authorizedAdminsUids').child(auth.uid).exists()",
      ".write": "false",
      "$uid": {
        ".read": "auth != null && $uid === auth.uid"
      }
    },
    "commandLog": {
      ".read": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())",
      ".write": "false"
    },
    "archivedDevices": {
      ".read": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())",
      ".write": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())"
    },
    "groups": {
      ".read": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())",
      ".write": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())"
    },
    "presets": {
      ".read": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())",
      ".write": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())"
    },
    "globalSettings": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())"
    },
    "storeApps": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || root.child('authorizedAdminsUids').child(auth.uid).exists())"
    }
  }
}
